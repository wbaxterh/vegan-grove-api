# Vegan Grove API environment. Names only; copy to .env and fill in locally. Never commit .env.

# development | test | production. Production requires SMTP, CORS_ORIGINS and DM_ENCRYPTION_KEY.
NODE_ENV=
# TCP port the API listens on (default 4000).
PORT=
# pino level: fatal, error, warn, info, debug, trace, silent (default info).
LOG_LEVEL=
# Number of proxies in front of the app (1 behind nginx) so rate limits see the client address.
TRUST_PROXY=
# Comma-separated browser origins allowed by CORS, e.g. the web app's URL.
CORS_ORIGINS=

# MongoDB connection string (Atlas SRV or local). Required.
MONGODB_URI=
# Database name override when the URI does not carry one.
MONGODB_DB_NAME=

# Sliding session lifetime in days (default 30).
SESSION_TTL_DAYS=
# Magic link lifetime in minutes (default 15).
MAGIC_LINK_TTL_MINUTES=
# Web page the magic link points to; the token is appended as ?token=.
MAGIC_LINK_BASE_URL=
# Requests per 15 minutes per IP on register, login, verify and provider sign-in (default 20).
RATE_LIMIT_AUTH_MAX=
# Magic link requests per 15 minutes per IP (default 5).
RATE_LIMIT_MAGIC_LINK_MAX=
# Companion turns per 15 minutes per member (default 60).
RATE_LIMIT_COMPANION_MAX=

# smtp (SES) or log. log prints that a link was issued, never the token (default log).
EMAIL_TRANSPORT=
# From header on outbound mail.
EMAIL_FROM=
# SES SMTP endpoint host for the region.
SMTP_HOST=
# SMTP port, 587 for STARTTLS or 465 for TLS (default 587).
SMTP_PORT=
# SES SMTP username.
SMTP_USER=
# SES SMTP password.
SMTP_PASS=

# AWS region for S3 (default us-east-1). Credentials come from the instance role or the AWS CLI chain.
AWS_REGION=
# S3 bucket that receives presigned image uploads. Uploads answer 503 until set.
S3_MEDIA_BUCKET=
# Presigned PUT lifetime in seconds (default 300).
S3_PRESIGN_TTL_SECONDS=
# Bunny Stream video library id (milestone 2).
BUNNY_STREAM_LIBRARY_ID=
# Bunny Stream API key (milestone 2).
BUNNY_STREAM_API_KEY=

# Anthropic API key for the companion. Companion answers 503 until set.
ANTHROPIC_API_KEY=
# Claude model id for the companion (default claude-opus-5).
COMPANION_MODEL=
# Max output tokens per companion turn (default 8192).
COMPANION_MAX_TOKENS=
# How many prior turns are sent back to the model (default 20).
COMPANION_HISTORY_LIMIT=

# 32 random bytes, base64, for DM encryption at rest. Generate: openssl rand -base64 32
DM_ENCRYPTION_KEY=
# Label stored with each message so keys can rotate (default v1).
DM_KEY_ID=
# Days before a DM row expires (default 90).
DM_RETENTION_DAYS=

# Sign in with Apple audience: the app bundle id or services id.
APPLE_CLIENT_ID=
# Comma-separated Google OAuth client ids (iOS, Android, web) accepted as audience.
GOOGLE_CLIENT_IDS=

# Overpass mirror for the OSM seed script (default kumi.systems).
OVERPASS_URL=
# Cache lifetime for GET /api/stats in milliseconds (default 300000).
STATS_CACHE_TTL_MS=
# Reminder worker tick interval in milliseconds (default 60000).
REMINDER_TICK_MS=
